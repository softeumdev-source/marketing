# Todos têm um valor padrão embutido no código para o app rodar out-of-the-box.
# ATENÇÃO: os padrões de ENCRYPTION_KEY e CRON_SECRET estão no código-fonte de um
# repositório público. Defina-os na Vercel e faça a rotação — o passo a passo
# está no README, em "Rotação de segredos".

# Supabase (públicos por design, protegidos por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://jkvcuofxuounpxpiwtoo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave AES-256 (32 bytes hex) usada para criptografar as senhas de app do Gmail.
# Gere com: openssl rand -hex 32
# Trocar esta chave torna as senhas já salvas ilegíveis — reconecte as contas.
ENCRYPTION_KEY=troque-por-32-bytes-hex

# Segredo que protege os endpoints /api/cron/* e as funções RPC do banco.
# Gere com: openssl rand -hex 24
# DEVE ser igual a public.mail_settings.worker_secret no Supabase E ao header
# x-cron-secret dos jobs do pg_cron, senão o worker responde 401.
CRON_SECRET=troque-e-atualize-no-banco

# Base pública usada nos links de rastreamento e descadastro.
# Se não definir, o app usa o host da requisição.
NEXT_PUBLIC_APP_URL=https://disparador-email-kappa.vercel.app
